{
  "questions": [
    {
      "id": "worktree",
      "kind": "choice",
      "label": "Where should this workflow make changes?",
      "options": [
        {
          "value": "current",
          "label": "Current checkout (default)",
          "description": "make changes in the checkout where the workflow starts"
        },
        {
          "value": "new",
          "label": "Separate worktree",
          "description": "make changes on a new branch in a separate Git worktree"
        }
      ],
      "default": "current"
    },
    {
      "id": "tuning-scope",
      "kind": "choice",
      "label": "How should harness, model and effort be chosen?",
      "options": [
        {
          "value": "single",
          "label": "Same for every step",
          "description": "pick one harness, model and effort for the whole workflow"
        },
        {
          "value": "per-group",
          "label": "Per step group (default)",
          "description": "pick harness, model and effort for each step group"
        }
      ],
      "default": "per-group"
    },
    {
      "id": "step-select",
      "kind": "multi",
      "label": "Which research stages should run?",
      "options": [
        {
          "value": "analyze-design",
          "label": "Design analysis (Figma / design links)",
          "description": "analyze-design"
        },
        {
          "value": "analyze-related",
          "label": "Related tickets & reference docs",
          "description": "analyze-related"
        },
        {
          "value": "research-context",
          "label": "Deep-dive context sweep (grill research)",
          "description": "research-context"
        },
        {
          "value": "gap-analysis",
          "label": "Gap analysis + blueprint + gap questions",
          "description": "gap-analysis"
        }
      ],
      "default": [
        "analyze-design",
        "analyze-related",
        "research-context",
        "gap-analysis"
      ]
    },
    {
      "id": "input.ticket_id",
      "kind": "text",
      "label": "Which ticket? (paste a URL, or an id like PROJ-123 / ENG-45 / #678)"
    },
    {
      "id": "input.review_mode",
      "kind": "choice",
      "label": "Review the plan before setup? (auto: accept the plan as presented | ask: pause for my comments, one refine pass)",
      "options": [
        {
          "value": "auto",
          "label": "auto (default)"
        },
        {
          "value": "ask",
          "label": "ask"
        }
      ],
      "default": "auto"
    },
    {
      "id": "input.branch_mode",
      "kind": "choice",
      "label": "Branch handling at setup? (auto: ticket branch off the base branch, dirty tree refused | current: stay on the current branch | ask: ask me at setup)",
      "options": [
        {
          "value": "auto",
          "label": "auto (default)"
        },
        {
          "value": "current",
          "label": "current"
        },
        {
          "value": "ask",
          "label": "ask"
        }
      ],
      "default": "auto"
    },
    {
      "id": "input.implement_mode",
      "kind": "choice",
      "label": "Implement the plan after setup? (plan-only: stop after setup | now: implement autonomously | ask: ask me once the plan and branch are settled)",
      "options": [
        {
          "value": "plan-only",
          "label": "plan-only (default)"
        },
        {
          "value": "now",
          "label": "now"
        },
        {
          "value": "ask",
          "label": "ask"
        }
      ],
      "default": "plan-only"
    },
    {
      "id": "input.base_branch",
      "kind": "text",
      "label": "Base branch for the ticket branch and its PR? (the checked-out base branch first, then the default branch and recent release* branches; type another name if needed)"
    }
  ],
  "defaults": {
    "worktree": "current",
    "tuning-scope": "per-group",
    "step-select": [
      "analyze-design",
      "analyze-related",
      "research-context",
      "gap-analysis"
    ],
    "input.review_mode": "auto",
    "input.branch_mode": "auto",
    "input.implement_mode": "plan-only"
  },
  "pages": [
    [
      "worktree",
      "tuning-scope",
      "step-select",
      "input.ticket_id"
    ],
    [
      "input.review_mode",
      "input.branch_mode",
      "input.implement_mode",
      "input.base_branch"
    ]
  ]
}
