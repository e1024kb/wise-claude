# Python source engine development commands.
python := ".venv/bin/python"

default: check

install:
    python3 -m venv .venv
    {{python}} -m pip install --disable-pip-version-check --require-hashes -r requirements-dev.txt

typecheck:
    .venv/bin/mypy wise_engine

lint:
    .venv/bin/ruff check wise_engine tests

fmt:
    .venv/bin/ruff format wise_engine tests

fmt-check:
    .venv/bin/ruff format --check wise_engine tests

test:
    {{python}} -m pytest tests -q

check: typecheck lint fmt-check test
    @echo "wise-engine: all checks passed (Python)"
